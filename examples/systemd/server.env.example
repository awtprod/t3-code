# Copy to ~/.command-center/config/server.env with mode 0600.
# Keep OAuth tokens, API keys, cookies, and encryption keys out of this file.

T3CODE_LOG_LEVEL=Info
T3CODE_TRACE_MIN_LEVEL=Info
T3CODE_TRACE_TIMING_ENABLED=true

# The service defaults to the adjacent private checkout at ~/.command-center-config.
# Set this only when the private checkout lives elsewhere.
# COMMAND_CENTER_CONFIG_DIR=/absolute/path/to/private-config-checkout
