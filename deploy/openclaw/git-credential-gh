#!/bin/sh
set -eu

identity=${1:-}
operation=${2:-}
case "$identity" in
  awtprod|ccn) ;;
  *) echo "git-credential-gh: expected awtprod or ccn" >&2; exit 77 ;;
esac
case "$operation" in
  get|store|erase) ;;
  *) echo "git-credential-gh: unsupported operation '$operation'" >&2; exit 77 ;;
esac

export COMMAND_CENTER_GITHUB_IDENTITY=$identity
export COMMAND_CENTER_GITHUB_PROVISIONING_IDENTITY=$identity
exec /opt/command-center/bin/gh auth git-credential "$operation"
