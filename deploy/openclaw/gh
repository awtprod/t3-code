#!/bin/sh
set -eu

case "${PWD:-}" in
  /srv/command-center/workspaces/primary|/srv/command-center/workspaces/primary/*)
    workspace_identity=primary
    ;;
  /srv/command-center/workspaces/secondary|/srv/command-center/workspaces/secondary/*)
    workspace_identity=secondary
    ;;
  *)
    workspace_identity=
    ;;
esac

requested_identity=${COMMAND_CENTER_GITHUB_IDENTITY:-}
provisioning_identity=${COMMAND_CENTER_GITHUB_PROVISIONING_IDENTITY:-}

if [ -n "$workspace_identity" ]; then
  if [ -n "$requested_identity" ] && [ "$requested_identity" != "$workspace_identity" ]; then
    echo "gh: provider identity '$requested_identity' does not match workspace identity '$workspace_identity'" >&2
    exit 77
  fi
  identity=$workspace_identity
elif [ -n "$provisioning_identity" ]; then
  identity=$provisioning_identity
else
  echo "gh: refusing GitHub access outside an identity-mapped workspace" >&2
  exit 77
fi

case "$identity" in
  primary) GH_CONFIG_DIR=/var/lib/command-center/gh/primary ;;
  secondary) GH_CONFIG_DIR=/var/lib/command-center/gh/secondary ;;
  *) echo "gh: unknown GitHub identity '$identity'" >&2; exit 77 ;;
esac

# GH_TOKEN/GITHUB_TOKEN in the environment take precedence over the identity's stored credential,
# so whatever token the session was launched with wins no matter which workspace we are standing in.
# That silently defeats the identity mapping above, and in practice the env token is a narrower
# classic PAT: 'repo' only, so `gh pr edit` fails on read:org and pushes touching .github/workflows
# are rejected for want of 'workflow'. Drop them when the identity has its own hosts.yml, and keep
# them as the fallback for a host that was never `gh auth login`-ed.
if [ -s "$GH_CONFIG_DIR/hosts.yml" ]; then
  unset GH_TOKEN GITHUB_TOKEN GH_ENTERPRISE_TOKEN GITHUB_ENTERPRISE_TOKEN
fi

export GH_CONFIG_DIR COMMAND_CENTER_GITHUB_IDENTITY=$identity
exec /usr/bin/gh "$@"
